	end
end)

local OC
OC = CHS:CreateButton({
	Name = "Collect Chairs",
	Callback = function()
		DescribeButton("Collect Chairs","Collects all chairs throwed.","archive-restore")
		local GotAny = false
		for i,v in pairs(game.Workspace.props:GetChildren()) do
			if v:IsA("MeshPart") and v.Name == "Chair 2" and isnetworkowner(v) then
				for i,v1 in pairs(CollectedChairs) do
					if v1.Chair == v then
						continue --skip
					end
				end
				GotAny = true
				local tbl = {
					Chair = v,
					InUse = false,
					TargetCFrame = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame - Vector3.new(0,37,0)
				}
				table.insert(CollectedChairs,tbl)
				task.spawn(function()
					local s = v.Size
					v.Size = Vector3.new(.5,.5,.5)
					while task.wait() and table.find(CollectedChairs,tbl) do
						v.CFrame = tbl.TargetCFrame
						v.Velocity = Vector3.new(5e5,5e5,5e5)
					end
					v.Size = s
				end)
			end
		end

		if GotAny then
			Rayfield:Notify({
				Title = "Success!",
				Content = "Stored your chair(s) in storage.",
				Duration = 4,
				Image = "check",
			})
		else
			Rayfield:Notify({
				Title = "Error",
				Content = "You dont own any throwed chairs.",
				Duration = 4,
				Image = "x",
			})
		end
	end
})

