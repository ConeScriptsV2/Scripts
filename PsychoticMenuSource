local CollectedChairs = {}

task.spawn(function()
	while wait() do
		for i,v in pairs(CollectedChairs) do
			if v["Chair"] and v["Chair"].Parent and isnetworkowner(v["Chair"]) then else
				table.remove(CollectedChairs,i)
			end
