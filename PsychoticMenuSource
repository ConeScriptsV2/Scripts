local function ResolvePlayer(input)
	local linput = input:lower()
	if linput == "all" then return game.Players:GetPlayers() elseif linput == "others" then
		local t = game.Players:GetPlayers()
		table.remove(t,table.find(t,game.Players.LocalPlayer))
		return t
	end

	for i,v in pairs(game.Players:GetPlayers()) do
		if v.Name:lower():match(linput) or v.DisplayName:lower():match(linput) then
			return {v}
		end
	end
end

local function DescribeButton(title,desc,icon)
	Rayfield:Notify({
		Title = title,
		Content = desc,
		Duration = 3,
		Image = icon,
	})
end
local function DescribeToggle(title,desc,val)
	Rayfield:Notify({
		Title = title,
		Content = desc,
		Duration = 3,
		Image = val and "square-check" or "square-x",
	})
end

